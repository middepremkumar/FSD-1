    {
      "name": "4. Products CRUD (4.d & 5.b)",
      "item": [
        {
          "name": "GET All Products",
          "request": {
            "method": "GET",
            "url": "http://localhost:5000/api/products"
          }
        },
        {
          "name": "GET Filter by Category (Mobiles)",
          "request": {
            "method": "GET",
            "url": "http://localhost:5000/api/products?category=Mobiles"
          }
        },
        {
          "name": "GET Search Products (Apple)",
          "request": {
            "method": "GET",
            "url": "http://localhost:5000/api/products?search=Apple"
          }
        },
        {
          "name": "GET Single Product #1",
          "request": {
            "method": "GET",
            "url": "http://localhost:5000/api/products/1"
          }
        },
        {
          "name": "POST Create Product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"OnePlus 12 (16GB RAM, 512GB Storage)\",\n  \"category_id\": 1,\n  \"price\": 64999,\n  \"original_price\": 69999,\n  \"stock_quantity\": 25,\n  \"deal_tag\": \"Launch Offer\",\n  \"badge\": \"New Arrival\",\n  \"delivery_info\": \"FREE Delivery Tomorrow\"\n}"
            },
            "url": "http://localhost:5000/api/products"
          }
        },
        {
          "name": "PUT Update Product #1",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Apple iPhone 15 (128 GB) - Blue [Special Sale]\",\n  \"price\": 65999,\n  \"category_id\": 1,\n  \"stock_quantity\": 35,\n  \"badge\": \"Flash Deal\",\n  \"deal_tag\": \"Festival Special\"\n}"
            },
            "url": "http://localhost:5000/api/products/1"
          }
        },
        {
          "name": "DELETE Product #8",
          "request": {
            "method": "DELETE",
            "url": "http://localhost:5000/api/products/8"
          }
        }
      ]

    {
      "name": "5. Orders & Checkout",
      "item": [
        {
          "name": "GET All Orders",
          "request": {
            "method": "GET",
            "url": "http://localhost:5000/api/orders"
          }
        },
        {
          "name": "POST Checkout New Order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_name\": \"Prem Kumar\",\n  \"customer_email\": \"prem.kumar@example.com\",\n  \"shipping_address\": \"Plot 105, Tech City Road, Hyderabad 500081\",\n  \"payment_method\": \"UPI\",\n  \"items\": [\n    {\n      \"product_id\": 1,\n      \"quantity\": 1,\n      \"price\": 69999\n    },\n    {\n      \"product_id\": 2,\n      \"quantity\": 1,\n      \"price\": 29990\n    }\n  ]\n}"
            },
            "url": "http://localhost:5000/api/orders"
          }
